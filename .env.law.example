# LawMind 联合部署环境变量示例
# 复制为 .env 后按需修改：cp .env.law.example .env

# ── LLM ─────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=deepseek-v4-pro
ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic

# ── 应用 ─────────────────────────────────────────────────────────────────────
APP_ENV=production
LOG_LEVEL=INFO
LAWMIND_ADMIN_PASSWORD=change_me
# Required at runtime. Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
LAWMIND_SESSION_SECRET=

# ── PostgreSQL ───────────────────────────────────────────────────────────────
LAWMIND_DB_USER=lawuser
LAWMIND_DB_PASSWORD=lawpass
LAWMIND_DB_NAME=lawmind_law

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=lawpass
